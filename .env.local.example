# =============================================================
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it's already in .gitignore.
# =============================================================

# --- Supabase ---------------------------------------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# --- Nodemailer / SMTP -------------------------------------------
# Any SMTP provider works (Gmail, Resend, SendGrid, Mailgun, etc).
# For Gmail: use an "App Password", not your normal password —
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Optional — defaults to SMTP_USER if omitted:
SMTP_FROM=you@gmail.com

# --- Site ---------------------------------------------------------
# Used for absolute URLs in page metadata (social share previews).
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
